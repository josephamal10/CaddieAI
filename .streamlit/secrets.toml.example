# Settings for the hosted demo on Streamlit Community Cloud.
# Paste these into the app's Settings → Secrets box with real values, not into this file.
# A local .streamlit/secrets.toml is ignored by git; never commit real keys.

# Run the pipeline inside the Streamlit app: there is no separate API server when hosted.
GOLF_BACKEND = "inprocess"
# Questions answered per UTC day across all visitors, so a public link can't run up the bill.
DAILY_QUESTION_LIMIT = "100"

GOOGLE_API_KEY = "paste-the-gemini-key-here"
JINA_API_KEY = "paste-the-jina-key-here"
PINECONE_API_KEY = "paste-the-pinecone-key-here"
