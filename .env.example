# Anthropic — Sonnet for generation, Haiku for routing when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_GENERATION_MODEL=claude-sonnet-4-20250514
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Jina embeddings
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v4
JINA_EMBED_DIM=1024

# Pinecone serverless
PINECONE_API_KEY=
PINECONE_INDEX_NAME=golf-ai-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Retrieval
RETRIEVE_TOP_K=6
RETRIEVE_MIN_SCORE=0.25

# Rerank the top RERANK_CANDIDATES vector matches down to RETRIEVE_TOP_K (uses JINA_API_KEY)
RERANK_ENABLED=true
JINA_RERANK_MODEL=jina-reranker-v3.5
RERANK_CANDIDATES=20
# Below this top rerank score the answer is "not enough information", with no LLM call
RERANK_MIN_SCORE=0.2

# App
APP_ENV=development
LOG_LEVEL=INFO

# Generation — gemini or claude
GOOGLE_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.6-flash
LLM_PROVIDER=gemini

# Phase 2 routing — one small LLM call sorts each question: static / live / prediction / off_topic
ROUTER_ENABLED=true
# Live and prediction questions are answered with Gemini + Google Search (needs LLM_PROVIDER=gemini)
LIVE_SEARCH_ENABLED=true

# Questions answered per UTC day across all visitors; 0 = no limit (the public demo uses 100)
DAILY_QUESTION_LIMIT=0
